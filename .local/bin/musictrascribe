#!/usr/bin/env bash
#
# transcribe.sh — TUI music transcription tool
# Dependencies: mpv, ffmpeg, sox (optional: aubio)
# Version 1.0.0

# --- Shell setup ---
if [ -z "$BASH_VERSION" ]; then
    echo "transcribe.sh requires bash" >&2
    exit 1
fi

# bash 3.2 compat: no set -o pipefail

# --- Constants ---
VERSION="1.0.0"
COLS=80
TICK_INTERVAL=0.5
IPC_TIMEOUT=0.3

# --- Global state ---
AUDIO_FILE=""
DURATION=0.0
POSITION=0.0
PLAYING=1
SPEED=1.0
SEMITONES=0
LOOP_A=""
LOOP_B=""
LOOP_ACTIVE=0
BPM=120
METRO_ACTIVE=0
METRO_PID=""
MPV_PID=""
LAST_TICK=0

# Bookmarks: parallel indexed arrays (bash 3.2 compat)
BKMK_TIME=("" "" "" "" "")
BKMK_NAME=("" "" "" "" "")

# --- Paths ---
SOCKET="/tmp/transcribe.sock"
WAVE_FILE="/tmp/transcribe_wave.txt"
RAW_FILE="/tmp/transcribe_wave.raw"

# --- Block characters for waveform ---
if [ "$(uname -s)" = "Darwin" ]; then
    # macOS: use ASCII fallback for waveform (UTF-8 can be unreliable in older terminals)
    CHARS=( ' ' '_' '-' '~' '+' '*' '#' '0' '8' )
else
    CHARS=( ' ' $'\xe2\x96\x81' $'\xe2\x96\x82' $'\xe2\x96\x83' $'\xe2\x96\x84' $'\xe2\x96\x85' $'\xe2\x96\x86' $'\xe2\x96\x87' $'\xe2\x96\x88' )
fi

# --- Utility functions ---

now_ms() {
    python3 -c "import time; print(int(time.time() * 1000))" 2>/dev/null || echo 0
}

math() {
    awk "BEGIN { print ($*); }" 2>/dev/null || echo 0
}

math_int() {
    awk "BEGIN { printf \"%d\", int($*) }" 2>/dev/null || echo 0
}

format_time() {
    awk -v s="$1" 'BEGIN {
        if(s < 0) s = 0
        h = int(s / 3600)
        m = int((s % 3600) / 60)
        sec = int(s % 60)
        if(h > 0) printf "%d:%02d:%02d", h, m, sec
        else printf "%d:%02d", m, sec
    }' 2>/dev/null
}

float_ge() {
    awk -v a="$1" -v b="$2" 'BEGIN{if(a >= b) exit 0; else exit 1}' 2>/dev/null
}

float_gt() {
    awk -v a="$1" -v b="$2" 'BEGIN{if(a > b) exit 0; else exit 1}' 2>/dev/null
}

clamp() {
    awk -v v="$1" -v mn="$2" -v mx="$3" 'BEGIN{
        if(v < mn) print mn
        else if(v > mx) print mx
        else print v
    }' 2>/dev/null || echo "$val"
}

mpv_alive() {
    [ -n "$MPV_PID" ] && kill -0 "$MPV_PID" 2>/dev/null
}

# --- Dependency checking ---

check_deps() {
    local missing=()
    local optional=()

    command -v mpv    >/dev/null 2>&1 || missing+=("mpv")
    command -v ffmpeg >/dev/null 2>&1 || missing+=("ffmpeg")
    command -v sox    >/dev/null 2>&1 || missing+=("sox")
    command -v nc     >/dev/null 2>&1 || missing+=("nc (netcat with -U flag)")
    command -v bc     >/dev/null 2>&1 || optional+=("bc (will use awk/python fallback)")

    # Check nc supports -U
    if command -v nc >/dev/null 2>&1; then
        if ! echo "" | nc -U -h 2>&1 | grep -q "UNIX"; then
            # Try another check: nc -U might need specific flag
            if ! nc -U 2>&1 | grep -qi "unix"; then
                optional+=("nc may not support Unix sockets")
            fi
        fi
    fi

    # Check for aubio (optional)
    command -v aubio     >/dev/null 2>&1 || \
    command -v aubiotrack >/dev/null 2>&1 || \
    command -v aubiobpm  >/dev/null 2>&1 || \
        optional+=("aubio (BPM detection)")

    # Check for waveform data tools
    command -v od >/dev/null 2>&1 || missing+=("od (from coreutils)")

    # Check tput
    command -v tput >/dev/null 2>&1 || missing+=("tput (from ncurses)")

    # Check stty
    command -v stty >/dev/null 2>&1 || missing+=("stty (from coreutils)")

    # Check python3 (for math)
    command -v python3 >/dev/null 2>&1 || optional+=("python3 (for IPC fallback)")

    if [ ${#missing[@]} -gt 0 ]; then
        echo "ERROR: Missing required dependencies:"
        for dep in "${missing[@]}"; do
            echo "  - $dep"
        done
        echo ""
        echo "Install with:"
        case "$(uname -s)" in
            Darwin)
                echo "  brew install mpv ffmpeg sox aubio socat"
                ;;
            Linux)
                echo "  apt install mpv ffmpeg sox aubio socat netcat-openbsd"
                ;;
        esac
        exit 1
    fi

    if [ ${#optional[@]} -gt 0 ]; then
        for dep in "${optional[@]}"; do
            echo "NOTE: $dep (optional)" >&2
        done
    fi
}

# --- IPC with mpv ---

send_ipc() {
    local cmd="$1"
    if command -v timeout >/dev/null 2>&1; then
        printf '%s\n' "$cmd" | timeout "$IPC_TIMEOUT" nc -U "$SOCKET" 2>/dev/null || true
    else
        tmpf=$(mktemp /tmp/mpv_resp_XXXX 2>/dev/null)
        printf '%s\n' "$cmd" | nc -U "$SOCKET" > "$tmpf" 2>/dev/null &
        local pid=$!
        sleep 0.2 2>/dev/null
        kill "$pid" 2>/dev/null || true
        cat "$tmpf" 2>/dev/null
        rm -f "$tmpf" 2>/dev/null
    fi
}

ipc_get() {
    local prop="$1"
    send_ipc "{\"command\":[\"get_property\",\"$prop\"]}" 2>/dev/null | \
        grep -o '"data":[^,}]*' | head -1 | cut -d: -f2
}

ipc_set() {
    local prop="$1" val="$2"
    send_ipc "{\"command\":[\"set_property\",\"$prop\",$val]}" >/dev/null
}

# --- mpv lifecycle ---

init_mpv() {
    rm -f "$SOCKET"

    mpv --no-video --input-ipc-server="$SOCKET" \
        --audio-file-auto=no \
        --msg-level=all=no \
        --term-status-msg=no \
        "$AUDIO_FILE" >/dev/null 2>&1 &
    MPV_PID=$!

    # Wait for socket to appear
    local tries=0
    while [ $tries -lt 30 ]; do
        [ -S "$SOCKET" ] && break
        sleep 0.1
        tries=$((tries + 1))
    done

    if [ ! -S "$SOCKET" ]; then
        echo "ERROR: mpv failed to start (socket not found)"
        exit 1
    fi

    # Get duration
    DURATION=$(ipc_get "duration" 2>/dev/null || echo 0)
    [ -z "$DURATION" ] || [ "$(float_gt "$DURATION" 0 && echo 1 || echo 0)" = "0" ] && DURATION=0

    # Get duration via ffprobe as fallback
    if [ "$(float_gt "$DURATION" 0 && echo 1 || echo 0)" = "0" ]; then
        DURATION=$(ffprobe -v error -show_entries format=duration \
            -of default=noprint_wrappers=1:nokey=1 "$AUDIO_FILE" 2>/dev/null || echo 0)
    fi
    [ -z "$DURATION" ] && DURATION=0

    # Start playback
    send_ipc '{"command":["set_property","pause",false]}' >/dev/null 2>&1
}

# --- Playback control ---

play_pause() {
    send_ipc '{"command":["cycle","pause"]}' >/dev/null
    PLAYING=$((1 - PLAYING))
}

seek_relative() {
    local secs="$1"
    send_ipc "{\"command\":[\"seek\",$secs]}" >/dev/null
}

set_speed() {
    SPEED=$(clamp "$1" 0.25 2.0)
    ipc_set "speed" "$SPEED"
}

set_pitch() {
    SEMITONES=$(clamp "$1" -6 6)
    local scale
    scale=$(math "2.0 ^ ($SEMITONES / 12.0)" 2>/dev/null || echo 1)
    ipc_set "audio-pitch-correction" "false"
    send_ipc "{\"command\":[\"af\",\"set\",\"rubberband=pitch-scale=$scale\"]}" >/dev/null
}

reset_pitch_speed() {
    set_speed 1.0
    set_pitch 0
    send_ipc "{\"command\":[\"af\",\"set\",\"\"]}" >/dev/null
    ipc_set "audio-pitch-correction" "true"
}

# --- Position polling ---

update_position() {
    local pos
    pos=$(ipc_get "playback-time" 2>/dev/null || echo "")
    if [ -n "$pos" ] && [ "$pos" != "null" ]; then
        POSITION=$pos
    fi
}

# --- A-B Loop ---

set_loop_a() {
    LOOP_A=$POSITION
}

set_loop_b() {
    if [ -n "$LOOP_A" ] && [ "$(float_gt "$POSITION" "$LOOP_A" && echo 1 || echo 0)" = "1" ]; then
        LOOP_B=$POSITION
    else
        LOOP_A=""
        LOOP_B=""
    fi
}

toggle_loop() {
    if [ "$LOOP_ACTIVE" = "1" ]; then
        LOOP_ACTIVE=0
    else
        if [ -n "$LOOP_A" ] && [ -n "$LOOP_B" ]; then
            LOOP_ACTIVE=1
        fi
    fi
}

check_loop() {
    if [ "$LOOP_ACTIVE" = "1" ] && [ -n "$LOOP_A" ] && [ -n "$LOOP_B" ]; then
        if [ "$(float_ge "$POSITION" "$LOOP_B" && echo 1 || echo 0)" = "1" ]; then
            send_ipc "{\"command\":[\"seek\",$LOOP_A,\"absolute\"]}" >/dev/null
            POSITION=$LOOP_A
        fi
    fi
}

# --- Bookmarks ---

load_bookmarks() {
    local bf="${AUDIO_FILE}.bookmarks"
    [ ! -f "$bf" ] && return
    while IFS='|' read -r slot ts name; do
        case "$slot" in
            1|2|3|4|5)
                BKMK_TIME[$((slot-1))]="$ts"
                BKMK_NAME[$((slot-1))]="$name"
                ;;
        esac
    done < "$bf"
}

save_bookmark_file() {
    local bf="${AUDIO_FILE}.bookmarks"
    > "$bf"
    for i in 0 1 2 3 4; do
        if [ -n "${BKMK_TIME[$i]}" ]; then
            printf '%s|%s|%s\n' "$((i+1))" "${BKMK_TIME[$i]}" "${BKMK_NAME[$i]}" >> "$bf"
        fi
    done
}

save_bookmark_prompt() {
    echo -n " Slot (1-5): "
    stty echo icanon 2>/dev/null || true
    read -r slot 2>/dev/null || slot=""
    case "$slot" in
        1|2|3|4|5)
            echo -n " Name: "
            read -r name 2>/dev/null || name=""
            BKMK_TIME[$((slot-1))]="$POSITION"
            BKMK_NAME[$((slot-1))]="$name"
            save_bookmark_file
            ;;
        *) echo " Canceled" ;;
    esac
    stty -echo -icanon min 0 time 0 2>/dev/null || true
}

goto_bookmark() {
    local slot="$1"
    local ts="${BKMK_TIME[$((slot-1))]}"
    if [ -n "$ts" ]; then
        send_ipc "{\"command\":[\"seek\",$ts,\"absolute\"]}" >/dev/null
        POSITION=$ts
    fi
}

# --- BPM Detection ---

detect_bpm() {
    local bpm=""
    if command -v aubiotrack >/dev/null 2>&1; then
        bpm=$(aubiotrack "$AUDIO_FILE" 2>/dev/null | grep -o '[0-9.]*' | tail -1)
    elif command -v aubiobpm >/dev/null 2>&1; then
        bpm=$(aubiobpm "$AUDIO_FILE" 2>/dev/null | grep -o '[0-9.]*' | tail -1)
    fi
    if [ -n "$bpm" ] && [ "$(float_gt "$bpm" 0 && echo 1 || echo 0)" = "1" ]; then
        BPM=$(math_int "($bpm + 0.5)" 2>/dev/null || echo "$bpm")
    fi
}

# --- Metronome ---

metro_loop() {
    local interval
    interval=$(math "60.0 / $BPM" 2>/dev/null || echo 0.5)
    # Minimum interval check
    if [ "$(float_gt "$interval" 0.01 && echo 1 || echo 0)" = "0" ]; then
        interval=0.5
    fi
    while [ "$METRO_ACTIVE" = "1" ]; do
        play -q -n synth 0.01 sine 1000 vol 0.3 2>/dev/null || true
        sleep "$interval" 2>/dev/null || sleep 0.5
    done
}

toggle_metronome() {
    if [ "$METRO_ACTIVE" = "1" ]; then
        METRO_ACTIVE=0
        if [ -n "$METRO_PID" ]; then
            kill "$METRO_PID" 2>/dev/null || true
            wait "$METRO_PID" 2>/dev/null || true
            METRO_PID=""
        fi
    else
        METRO_ACTIVE=1
        metro_loop &
        METRO_PID=$!
    fi
}

# --- Waveform generation ---

generate_waveform() {
    local file="$1"
    local out="$WAVE_FILE"
    local cols="${COLS:-80}"

    [ ! -f "$file" ] && return 1

    local duration
    duration=$(ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)
    [ -z "$duration" ] && duration=$(sox --info -D "$file" 2>/dev/null)
    [ -z "$duration" ] && duration=60

    rm -f "$RAW_FILE"

    # Use integer rate (100 Hz) to get ~100 * duration ample samples
    sox "$file" -c 1 -r 100 -e float -t raw "$RAW_FILE" 2>/dev/null

    if [ -f "$RAW_FILE" ] && [ -s "$RAW_FILE" ]; then
        od -An -f "$RAW_FILE" 2>/dev/null | \
            awk -v cols="$cols" '
            BEGIN {
                idx = 0
                maxg = 0
            }
            {
                for(i=1;i<=NF;i++) {
                    v = $i
                    if(v < 0) v = -v
                    vals[idx] = v
                    if(v > maxg) maxg = v
                    idx++
                }
            }
            END {
                if(maxg <= 0 || idx == 0) {
                    for(i=0;i<cols;i++) print "4"
                } else {
                    if(idx < cols) step = 1
                    else step = int(idx / cols)
                    if(step < 1) step = 1
                    for(i=0;i<idx;i++) {
                        b = int(i / step)
                        if(b >= cols) b = cols - 1
                        if(vals[i] > bucket[b]) bucket[b] = vals[i]
                    }
                    for(i=0;i<cols;i++) {
                        d = int((bucket[i]/maxg)*8 + 0.5)
                        if(d < 0) d = 0
                        if(d > 8) d = 8
                        print d
                    }
                }
            }' > "$out" 2>/dev/null
    fi

    rm -f "$RAW_FILE" 2>/dev/null

    if [ ! -s "$out" ]; then
        > "$out" 2>/dev/null || true
        i=0; while [ "$i" -lt "$cols" ]; do echo "4"; i=$((i + 1)); done >> "$out" 2>/dev/null
    fi
}

# --- HUD drawing ---

draw_ui() {
    # Update position
    update_position
    check_loop

    local buf=""

    # ── Title bar ──
    local fname
    fname=$(basename "$AUDIO_FILE")
    local title="TRANSCRIBE.SH  —  $fname"
    buf="${buf}${title}\n"
    # Draw separator
    local sep=""
    local j=0
    while [ $j -lt "$COLS" ]; do
        sep="${sep}─"
        j=$((j + 1))
    done
    buf="${buf}${sep}\n"

    # ── Waveform line ──
    local wave_line
    wave_line=$(draw_waveform)
    buf="${buf}${wave_line}\n"

    # ── A-B loop / BPM / Metro line ──
    local loop_status="OFF"
    [ "$LOOP_ACTIVE" = "1" ] && loop_status="ON"
    local metro_status="OFF"
    [ "$METRO_ACTIVE" = "1" ] && metro_status="ON"

    local a_str="--"
    local b_str="--"
    if [ -n "$LOOP_A" ]; then
        a_str=$(format_time "$LOOP_A")
    fi
    if [ -n "$LOOP_B" ]; then
        b_str=$(format_time "$LOOP_B")
    fi

    local info_line="A:${a_str}  B:${b_str}  LOOP:${loop_status}  BPM:${BPM}  metro:${metro_status}"
    buf="${buf}${info_line}\n"

    # ── Separator ──
    buf="${buf}${sep}\n"

    # ── Pitch / Speed line ──
    local pitch_str="PITCH: ${SEMITONES} semitones"
    local speed_str="SPEED: ${SPEED}x"
    buf="${buf}${pitch_str}   ${speed_str}\n"

    # ── Bookmarks line ──
    local bm_str="BOOKMARKS:"
    for i in 0 1 2 3 4; do
        if [ -n "${BKMK_TIME[$i]}" ]; then
            local ts_short
            ts_short=$(format_time "${BKMK_TIME[$i]}")
            bm_str="${bm_str}  [$((i+1))]${ts_short}-${BKMK_NAME[$i]}"
        else
            bm_str="${bm_str}  [$((i+1))]--"
        fi
    done
    buf="${buf}${bm_str}\n"

    # ── Separator ──
    buf="${buf}${sep}\n"

    # ── Keybinds ──
    buf="${buf}  SPACE play/pause   ←/→ seek±5s   A set A   B set B\n"
    buf="${buf}  L toggle loop      [ speed-      ] speed+\n"
    buf="${buf}  - pitch down       = pitch up    R reset pitch+speed\n"
    buf="${buf}  1-5 bookmark go    S save mark   D detect BPM   M metro\n"
    buf="${buf}  W waveform reload  ? help        Q quit\n"

    # ── Bottom border ──
    local bottom=""
    j=0
    while [ $j -lt "$COLS" ]; do
        bottom="${bottom}─"
        j=$((j + 1))
    done
    buf="${buf}${bottom}"

    # Render in one shot
    tput cup 0 0 2>/dev/null
    printf '%b' "$buf"
}

draw_waveform() {
    local cols="${COLS:-80}"
    local -a line=()

    # Read waveform values into character array (one char per column)
    local i=0
    if [ -f "$WAVE_FILE" ]; then
        while IFS='' read -r val && [ "$i" -lt "$cols" ]; do
            v=$((val))
            [ "$v" -lt 0 ] && v=0
            [ "$v" -gt 8 ] && v=8
            line[$i]="${CHARS[$v]}"
            i=$((i + 1))
        done < "$WAVE_FILE"
    fi

    # Fill missing columns with middle level
    while [ "$i" -lt "$cols" ]; do
        line[$i]="${CHARS[4]}"
        i=$((i + 1))
    done

    # Calculate playhead column index
    local pos_col=0
    if [ "$(float_gt "$DURATION" 0 && echo 1 || echo 0)" = "1" ]; then
        pos_col=$(math_int "($POSITION / $DURATION) * $cols" 2>/dev/null || echo 0)
    fi
    [ -z "$pos_col" ] && pos_col=0
    [ "$pos_col" -ge "$cols" ] && pos_col=$((cols - 1))

    # Replace playhead column with pipe character
    line[$pos_col]="|"

    # Build final string from array
    local wave_str=""
    local c
    for c in "${line[@]}"; do
        wave_str="${wave_str}${c}"
    done

    local current_str duration_str
    current_str=$(format_time "$POSITION" 2>/dev/null || echo "0:00")
    duration_str=$(format_time "$DURATION" 2>/dev/null || echo "0:00")

    echo "${wave_str}  ${current_str} / ${duration_str}"
}

# --- Help screen ---

show_help() {
    tput clear 2>/dev/null
    cat <<'EOF'
                          TRANSCRIBE.SH — HELP

  PLAYBACK:
    SPACE          Play / Pause
    ← / →          Seek backward / forward 5 seconds

  SPEED:
    [ / ]          Decrease / Increase speed by 0.05 (range: 0.25x - 2.00x)
    R              Reset pitch and speed to defaults

  PITCH:
    - / =          Decrease / Increase pitch by 1 semitone (range: -6 to +6)
    R              Reset pitch and speed to defaults

  A-B LOOP:
    A              Set loop start point
    B              Set loop end point (must be after A)
    L              Toggle loop on / off

  BOOKMARKS:
    1-5            Jump to bookmark in that slot
    S <1-5>        Save current position to bookmark slot, then enter name

  ANALYSIS:
    D              Detect BPM (requires aubio)
    M              Toggle metronome tick

  DISPLAY:
    W              Regenerate waveform display

  GENERAL:
    ?              Show this help screen
    Q              Quit

  Press any key to return...
EOF
    read -rsn1
}

# --- File picker ---

file_picker() {
    local audio_exts=(-name "*.mp3" -o -name "*.wav" -o -name "*.flac" \
        -o -name "*.ogg" -o -name "*.m4a" -o -name "*.aiff" \
        -o -name "*.aif" -o -name "*.wma")

    echo "Select an audio file (enter number):"
    echo ""

    # Collect files
    local files=()
    while IFS='' read -r f; do
        files+=("$f")
    done < <(find . -maxdepth 2 -type f \( "${audio_exts[@]}" \) 2>/dev/null | sort | head -30)

    if [ ${#files[@]} -eq 0 ]; then
        echo "No audio files found in current directory."
        echo "Usage: $0 <audiofile>"
        exit 1
    fi

    select f in "${files[@]}"; do
        if [ -n "$f" ]; then
            AUDIO_FILE="$f"
            break
        fi
    done
}

# --- Keyboard input ---

process_key() {
    local key="$1"

    # Handle escape sequences (for arrow keys)
    if [ "$key" = $'\e' ]; then
        read -t 0.05 -n 1 -r key2 2>/dev/null || return
        if [ "$key2" = "[" ]; then
            read -t 0.05 -n 1 -r key3 2>/dev/null || return
            case "$key3" in
                D) seek_relative -5 ;;
                C) seek_relative  5 ;;
            esac
        fi
        return
    fi

    case "$key" in
        ' ')
            play_pause
            ;;
        'q'|'Q')
            cleanup
            exit 0
            ;;
        'a'|'A')
            set_loop_a
            ;;
        'b'|'B')
            set_loop_b
            ;;
        'l'|'L')
            toggle_loop
            ;;
        '[')
            local ns
            ns=$(math "$SPEED - 0.05")
            ns=$(clamp "$ns" 0.25 2.0)
            set_speed "$ns"
            ;;
        ']')
            local ns
            ns=$(math "$SPEED + 0.05")
            ns=$(clamp "$ns" 0.25 2.0)
            set_speed "$ns"
            ;;
        '-')
            local ns
            ns=$(math "$SEMITONES - 1")
            ns=$(clamp "$ns" -6 6)
            set_pitch "$ns"
            ;;
        '=')
            local ns
            ns=$(math "$SEMITONES + 1")
            ns=$(clamp "$ns" -6 6)
            set_pitch "$ns"
            ;;
        'r'|'R')
            reset_pitch_speed
            ;;
        [1-5])
            goto_bookmark "$key"
            ;;
        's'|'S')
            save_bookmark_prompt
            ;;
        'd'|'D')
            detect_bpm
            ;;
        'm'|'M')
            toggle_metronome
            ;;
        'w'|'W')
            generate_waveform "$AUDIO_FILE"
            ;;
        '?')
            show_help
            ;;
    esac
}

# --- Cleanup ---

cleanup() {
    trap '' EXIT INT TERM

    # Kill metronome
    if [ -n "$METRO_PID" ]; then
        kill "$METRO_PID" 2>/dev/null || true
        wait "$METRO_PID" 2>/dev/null || true
    fi

    # Kill mpv
    if [ -n "$MPV_PID" ]; then
        kill "$MPV_PID" 2>/dev/null || true
        wait "$MPV_PID" 2>/dev/null || true
    fi

    # Clean up IPC socket
    rm -f "$SOCKET" 2>/dev/null

    # Clean up temp files
    rm -f "$WAVE_FILE" "$RAW_FILE" /tmp/mpv_resp_* 2>/dev/null

    # Restore terminal
    stty sane 2>/dev/null
    tput cnorm 2>/dev/null
    tput cup 999 0 2>/dev/null
    echo ""
    echo "Done."
}

# --- Main ---

redraw_flag=0

sigwinch_handler() {
    redraw_flag=1
}

main() {
    if [ $# -eq 0 ]; then
        file_picker
    else
        AUDIO_FILE="$1"
    fi

    if [ ! -f "$AUDIO_FILE" ]; then
        echo "ERROR: File not found: $AUDIO_FILE"
        exit 1
    fi

    check_deps
    trap cleanup EXIT INT TERM
    trap sigwinch_handler WINCH

    tput clear 2>/dev/null
    tput civis 2>/dev/null

    load_bookmarks

    # Generate waveform in foreground (fast enough even for long files)
    generate_waveform "$AUDIO_FILE"

    # Start mpv
    init_mpv

    stty -echo -icanon min 0 time 0 2>/dev/null

    LAST_TICK=$(now_ms)
    draw_ui

    # ── Main loop ──
    while true; do
        local redraw_this_tick=0

        if [ "$redraw_flag" = "1" ]; then
            redraw_this_tick=1
            redraw_flag=0
        fi

        # Non-blocking key input (50ms timeout)
        if read -t 0.05 -n 1 -r key 2>/dev/null; then
            process_key "$key"
            redraw_this_tick=1
            LAST_TICK=$(now_ms)
        fi

        # Check if mpv is still alive
        if [ -n "$MPV_PID" ] && ! kill -0 "$MPV_PID" 2>/dev/null; then
            # mpv has exited — update position one last time
            update_position
            redraw_this_tick=1
            MPV_PID=""
        fi

        # Timer-based redraw
        local now
        now=$(now_ms)
        local elapsed=$((now - LAST_TICK))
        local interval_ms
        interval_ms=$(math_int "$TICK_INTERVAL * 1000" 2>/dev/null || echo 500)

        if [ "$elapsed" -ge "$interval_ms" ]; then
            redraw_this_tick=1
            LAST_TICK=$now
        fi

        if [ "$redraw_this_tick" = "1" ]; then
            draw_ui
        fi
    done
}

main "$@"
