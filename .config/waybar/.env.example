# Values are literal; shell commands and variables are not evaluated.
OCTO_HOST=''
OCTO_USER=''
SLACK_URL=''
# Website account reminder; sign in through the browser.
SLACK_USER=''
# Chromium profile directory for the profile named gugu.
SLACK_PROFILE='Profile 1'
SLACK_FLATPAK=io.github.ungoogled_software.ungoogled_chromium
# Default starting directory for Pi. ~ means your home directory.
PI_START_DIR='~'
